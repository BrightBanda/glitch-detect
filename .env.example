# Copy to .env and fill in. These are server-side defaults: they never reach
# the browser, and a key entered in the UI's Settings overrides them.
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Optional
# PORT=8501
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# GROQ_BASE_URL=https://api.groq.com/openai/v1
