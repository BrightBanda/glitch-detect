# Copy to .env and fill in. Keys here are server-side defaults: they never
# reach the browser, and a key entered in the UI's Settings overrides them.

# Easiest: list any keys here, comma-separated. The provider of each key is
# recognised automatically (Groq gsk_…, OpenRouter sk-or-…, Gemini AIza…,
# OpenAI sk-…, Cerebras csk-…, xAI xai-…, Mistral, DeepSeek, Together).
LLM_API_KEYS=

# Or name the provider explicitly:
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# MISTRAL_API_KEY=
# CEREBRAS_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# TOGETHER_API_KEY=

# Enables /api/admin/keys (add / list / remove keys at runtime, e.g. from an
# admin dashboard). Requests must send "Authorization: Bearer <ADMIN_TOKEN>".
# ADMIN_TOKEN=

# Optional
# PORT=8501
# GLITCH_INSTANCE_DIR=./instance        # where admin-added keys are stored
# <PROVIDER>_BASE_URL=...               # e.g. GROQ_BASE_URL, for testing
